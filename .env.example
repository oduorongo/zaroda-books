# Vercel Marketplace > Neon creates this for you and injects it automatically.
DATABASE_URL="postgres://user:password@host/db?sslmode=require"

# Generate with: openssl rand -base64 32
AUTH_SECRET=""

# Tuma (https://tuma.co.ke) — M-Pesa STK push for the Books subscription.
# Generate the API key from your Tuma business profile (Settings > API Key).
TUMA_EMAIL=your-tuma-account-email
TUMA_API_KEY=your-tuma-api-key

# Where Tuma sends the payment callback. Must be publicly reachable, so a
# localhost value will never receive one — on Vercel this is filled in from
# the deployment automatically, and only needs setting for a custom domain.
APP_URL=https://your-domain.example

# Resend — password reset and invitation email.
RESEND_API_KEY=re_...
RESEND_FROM="Zaroda Books <support@zarodasolutions.app>"

# Testing only. Sends every email to this address instead of the person it
# names, which is also how to send at all before a domain is verified with
# Resend. Leave it unset in production: a tenant's password reset link would
# otherwise arrive in somebody else's inbox.
EMAIL_REDIRECT_TO=

# Where to tell you a new tenant has signed up and is waiting for approval.
# Unset, nothing is sent — the owner console still flags them.
ADMIN_NOTIFY_EMAIL=oduorongo@gmail.com
